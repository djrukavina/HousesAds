# Copy to .env and fill in at least one notifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Seconds between full scrape cycles.
POLL_INTERVAL_SEC=120

# HTTP API for the Android app (use your PC LAN IP on a real phone).
API_HOST=0.0.0.0
API_PORT=8765

# Playwright is used when a site blocks plain HTTP.
HEADLESS=true
REQUEST_DELAY_SEC=2.0
MAX_PAGES=3

# Copy to .env for local runs. On GitHub Actions, set the same values as repository secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Free phone push via ntfy.app — set a private topic, then subscribe in the ntfy Android app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Private inbox used when you delete an ad in the app. GitHub Actions reads it.
NTFY_HIDE_TOPIC=

# Fast cycle: only page 1 of the 3 filters. New ads always appear first.
POLL_INTERVAL_SEC=30
MAX_PAGES=1
REQUEST_DELAY_SEC=1.0

API_HOST=0.0.0.0
API_PORT=8765
HEADLESS=true
